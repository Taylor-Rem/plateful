<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pin the host the tests assume. Without these, CI's `cp .env.example .env`
             leaves PLATFORM_PRIMARY_DOMAIN=your-app.laravel.cloud, so every admin-host
             route (Route::domain('admin.'.primary_domain)) binds to the wrong domain
             and the admin/super-admin tests 404. Keep in sync with the hardcoded
             admin.plateful.test in tests (e.g. AdminHomeTest's HOME_ADMIN_BASE). -->
        <env name="APP_URL" value="http://plateful.test"/>
        <env name="PLATFORM_PRIMARY_DOMAIN" value="plateful.test"/>
        <!-- Pinned empty (same pattern as the DOORDASH_* pins below) so a
             developer's real scheduling links in .env can't flip the
             booking-page defaults the suite asserts on. -->
        <env name="PLATFORM_BOOKING_URL" value="" force="true"/>
        <env name="PLATFORM_BOOKING_URL_LONG" value="" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- No SSR gateway runs in tests; without this every Inertia render
             attempts an HTTP call to 127.0.0.1:13714, which the global
             Http::preventStrayRequests() guard (tests/Pest.php) rejects. -->
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Keyless on purpose: CampaignMailer logs batches instead of calling
             Resend, so campaign pipeline tests can never send real email. -->
        <env name="RESEND_API_KEY" value="" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Fake DoorDash platform credentials. DoorDashJwtService::mint() throws
             notConfigured when any of these is empty, so the storefront quote tests
             died in CI (where `cp .env.example .env` supplies none) while passing
             locally off the developer .env's real sandbox creds. The signing secret
             is base64url-decoded before signing, so it must be valid base64url —
             this one decodes to "test-signing-secret". There is no DoorDash
             live-sandbox suite (Uber/Square/Clover key off separate *_SANDBOX_*
             vars), so no test wants the real values. -->
        <env name="DOORDASH_DEVELOPER_ID" value="test-developer-id" force="true"/>
        <env name="DOORDASH_KEY_ID" value="test-key-id" force="true"/>
        <env name="DOORDASH_SIGNING_SECRET" value="dGVzdC1zaWduaW5nLXNlY3JldA" force="true"/>
        <env name="DOORDASH_WEBHOOK_SECRET" value="test-webhook-secret" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
